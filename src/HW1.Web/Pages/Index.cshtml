@page
@model HW1.Web.Pages.IndexModel
@{
    ViewData["Title"] = "HW1";
}

<div class="container py-4">
    <div class="mb-4">
        <h1>Meeting Time Finder</h1>
        <p class="lead">
            Enter the times when people are busy to find possible meeting times.
        </p>
    </div>

    @* Post form for submitting busy times. *@
    <form method="post">
        <div class="mb-3">
            <label asp-for="BusyTimes" class="form-label">
                Busy times
            </label>

            @* Collects all busy-time ranges as one string. *@
            <textarea asp-for="BusyTimes"
                      class="form-control"
                      rows="5"
                      placeholder="Monday 9:00 AM - 11:00 AM; Wednesday 2:00 PM - 4:00 PM"></textarea>

            @* Explains the required busy-time input format. *@
            <div class="form-text">
                <div>
                    <strong>Format:</strong>
                    <code>Day h:mm AM - h:mm PM</code>
                </div>

                <div>
                    <strong>Example:</strong>
                    <code>Monday 9:00 AM - 11:00 AM; Wednesday 2:00 PM - 4:00 PM</code>
                </div>

                <div>
                    Use full day names and whole-hour times between
                    9:00 AM and 5:00 PM. Separate multiple ranges
                    with semicolons.
                </div>
            </div>
        </div>

        @* Determines whether Saturday and Sunday may be meeting days. *@
        <div class="form-check mb-3">
            <input asp-for="IncludeWeekends" class="form-check-input" />

            <label asp-for="IncludeWeekends" class="form-check-label">
                Include weekends as possible meeting days
            </label>
        </div>

        <button type="submit" class="btn btn-primary">
            Find Available Times
        </button>
    </form>

    @* Displays a parsing or validation error without removing the form input. *@
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger mt-4">
            @Model.ErrorMessage
        </div>
    }
    else if (Model.WasSubmitted)
    {
        var days = Model.Schedule
            .Select(slot => slot.Day)
            .Distinct()
            .ToList();

        var startTimes = Model.Schedule
            .Select(slot => slot.StartTime)
            .Distinct()
            .ToList();

        @* Displays the calculated schedule by day and hour. *@
        <div class="table-responsive mt-4">
            <table class="table table-bordered text-center">
                <thead>
                    <tr>
                        <th scope="col">Time</th>

                        @foreach (var day in days)
                        {
                            <th scope="col">@day</th>
                        }
                    </tr>
                </thead>

                <tbody>
                    @foreach (var startTime in startTimes)
                    {
                        var endTime = startTime.AddHours(1);

                        <tr>
                            <th scope="row">
                                @startTime.ToString("h:mm tt")
                                -
                                @endTime.ToString("h:mm tt")
                            </th>

                            @foreach (var day in days)
                            {
                                var slot = Model.Schedule.Single(
                                    scheduleSlot =>
                                        scheduleSlot.Day == day &&
                                        scheduleSlot.StartTime == startTime
                                );

                                @* Added colors to schedule.  *@
                                <td class="@(slot.IsBusy
                                    ? "table-danger"
                                    : "table-success")">
                                    <strong>
                                        @(slot.IsBusy ? "Busy" : "Free")
                                    </strong>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>