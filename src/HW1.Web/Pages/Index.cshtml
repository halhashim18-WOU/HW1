@page
@model HW1.Web.Pages.IndexModel
@{
    ViewData["Title"] = "HW1";
}

<div class="container py-4">
    <div class="mb-4">
        <h1>Meeting Time Finder</h1>
        <p class="lead">
            Enter the times when people are busy to find possible meeting times.
        </p>
    </div>

    @*Post form for submitting busy times*@
    <form method="post">
        <div class="mb-3">
            <label asp-for="BusyTimes" class="form-label">
                Busy times
            </label>

            @* Collects all busy-time ranges as one string. *@
            <textarea asp-for="BusyTimes"
                      class="form-control"
                      rows="5"
                      placeholder="Monday 9:00 AM - 11:00 AM; Wednesday 2:00 PM - 4:00 PM"></textarea>

            <div class="form-text">
                Separate multiple busy-time ranges with semicolons.
            </div>
        </div>

        @* Determines whether Saturday and Sunday may be meeting days. *@
        <div class="form-check mb-3">
            <input asp-for="IncludeWeekends" class="form-check-input" />

            <label asp-for="IncludeWeekends" class="form-check-label">
                Include weekends as possible meeting days
            </label>
        </div>

        <button type="submit" class="btn btn-primary">
            Find Available Times
        </button>
    </form>

    @* Temp *@
    @if (Model.WasSubmitted)
    {
        <div class="alert alert-info mt-4">
            Form was submitted with the following values:
            <ul>
                <li>Busy times: @Model.BusyTimes</li>
                <li>Include weekends: @Model.IncludeWeekends</li>
            </ul>
        </div>
    }
</div>